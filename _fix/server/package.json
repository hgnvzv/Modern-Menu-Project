{
  "name": "qr-menu-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pi Game Center — QR menu backend (Fastify + SQLite). Public menu, guest/table sessions, waiter & bill requests, and the protected admin API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/dev/seed.ts",
    "create-admin": "tsx src/dev/create-admin.ts",
    "create-staff": "tsx src/dev/create-staff.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
