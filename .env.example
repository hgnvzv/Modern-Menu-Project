# Optional: base path for the API. Defaults to "/api" (same-origin), which is
# what you want when the Fastify server serves the built client, or when Vite
# proxies /api in dev. Only change this if the API lives on a different origin.
VITE_API_BASE_URL=/api

# Dev only: where Vite proxies "/api" and "/uploads" during `npm run dev`.
# Must match the server's PORT (server/.env). Not used in production.
VITE_API_PROXY_TARGET=http://localhost:3000
